# Server listening port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/CollabBoard

# JSON Web Token configurations
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=7d

# Google OAuth Credentials (Get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Google Redirect Callback (Set this to the backend API callback URL)
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary Credentials (optional, for asset/file upload storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend Client URL (used for CORS and socket origins)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

# Google Gemini API Key (for whiteboard AI features)
GEMINI_API_KEY=your_gemini_api_key
